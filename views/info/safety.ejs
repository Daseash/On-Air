<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-shield-halved"></i> Trust & Safety</span>
    <h1>Your Safety is Our Top Priority</h1>
    <p class="mx-auto">From identity verification and secure bookings to 24/7 incident assistance, learn how ON AIR keeps our community safe.</p>
  </div>

  <!-- Safety Pillars -->
  <div class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-id-card-clip"></i></div>
        <h3>Verified Accounts & Homes</h3>
        <p>Hosts and listings undergo verification checks to ensure photographs, amenities, and host identities reflect real homes.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-lock"></i></div>
        <h3>Secure Encrypted Bookings</h3>
        <p>All reservation payments are handled through secure encrypted channels. Never transfer funds or communicate off the platform.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-fire-extinguisher"></i></div>
        <h3>Home Safety Essentials</h3>
        <p>We require hosts to equip homes with functional smoke detectors, accessible first aid supplies, and clear emergency egress routes.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-headset"></i></div>
        <h3>24/7 Incident Escalation</h3>
        <p>Our dedicated Trust & Safety response team investigates issues promptly to protect guests and hosts alike.</p>
      </div>
    </div>
  </div>

  <!-- Safety Checklist for Travelers -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-list-check"></i> Traveler Safety Checklist</h2>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="p-3 border rounded-3 bg-white h-100">
          <h4 class="h6 fw-bold mb-2"><i class="fa-solid fa-1 me-2 text-muted"></i> Before You Book</h4>
          <p class="small text-muted mb-0">Read guest reviews carefully, check house rules, examine property location maps, and confirm cancellation flexibility.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 border rounded-3 bg-white h-100">
          <h4 class="h6 fw-bold mb-2"><i class="fa-solid fa-2 me-2 text-muted"></i> Upon Arrival</h4>
          <p class="small text-muted mb-0">Locate emergency exits, test doors and locks, identify the first-aid kit and fire extinguisher, and report any discrepancies right away.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 border rounded-3 bg-white h-100">
          <h4 class="h6 fw-bold mb-2"><i class="fa-solid fa-3 me-2 text-muted"></i> During Your Stay</h4>
          <p class="small text-muted mb-0">Adhere to quiet hours (10 PM – 8 AM), keep doors locked when leaving, and message the host directly via your account for any questions.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Emergency Assistance -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-phone-volume"></i> Emergency Contacts</h2>
    <div class="p-4 border rounded-3 bg-white">
      <p class="text-muted">If you are facing an active emergency or immediate physical risk, always notify local authorities immediately before contacting support.</p>
      <div class="row g-3 text-center">
        <div class="col-6 col-md-3">
          <div class="p-3 bg-light rounded-3">
            <span class="d-block fw-bold fs-4 text-dark">112</span>
            <span class="small text-muted">National Emergency (India)</span>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 bg-light rounded-3">
            <span class="d-block fw-bold fs-4 text-dark">100</span>
            <span class="small text-muted">Police Control</span>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 bg-light rounded-3">
            <span class="d-block fw-bold fs-4 text-dark">108</span>
            <span class="small text-muted">Ambulance Services</span>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 bg-light rounded-3">
            <span class="d-block fw-bold fs-4 text-dark">101</span>
            <span class="small text-muted">Fire & Rescue</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Report Issue -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Notice something that feels unsafe?</h3>
      <p class="mb-0 text-muted">File a confidential concern with our Trust & Safety team anytime.</p>
    </div>
    <div>
      <a href="/report-concern" class="btn btn-dark rounded-pill px-4">Report a Concern</a>
    </div>
  </div>
</div>
