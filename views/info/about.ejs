<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-compass"></i> Our Mission</span>
    <h1>Belong Anywhere. Breathe Free.</h1>
    <p class="mx-auto">ON AIR was founded on a simple conviction: travel should be soulful, effortless, and grounded in authentic hospitality.</p>
  </div>

  <!-- Story & Vision -->
  <div class="info-section">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h2 class="fw-bold mb-3" style="font-family: var(--font-display); font-size: 1.85rem;">Redefining the way people discover and experience stays</h2>
        <p class="text-muted leading-relaxed mb-3">
          Too many travel booking sites became noisy, cluttered, and opaque — full of artificial timers, hidden checkout fees, and sterile corporate hotels.
        </p>
        <p class="text-muted leading-relaxed mb-3">
          We designed <strong>ON AIR</strong> to celebrate extraordinary architecture and homestays: cliffside villas in Bali, cedar chalets in the Himalayas, beachfront cottages in Goa, and historic estates across Europe.
        </p>
        <p class="text-muted leading-relaxed mb-0">
          Coupled with our proprietary AI Travel Concierge — <strong>E.D.I.T.H.</strong> — ON AIR enables anyone to discover their next dream destination naturally and effortlessly.
        </p>
      </div>
      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div class="p-4 border rounded-3 bg-white text-center">
              <span class="display-6 fw-bold text-dark d-block">10,000+</span>
              <span class="small text-muted">Curated Stays</span>
            </div>
          </div>
          <div class="col-6">
            <div class="p-4 border rounded-3 bg-white text-center">
              <span class="display-6 fw-bold text-dark d-block">45+</span>
              <span class="small text-muted">Countries Explored</span>
            </div>
          </div>
          <div class="col-6">
            <div class="p-4 border rounded-3 bg-white text-center">
              <span class="display-6 fw-bold text-dark d-block">4.9 ★</span>
              <span class="small text-muted">Average Rating</span>
            </div>
          </div>
          <div class="col-6">
            <div class="p-4 border rounded-3 bg-white text-center">
              <span class="display-6 fw-bold text-dark d-block">100k+</span>
              <span class="small text-muted">Memorable Nights</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Core Values -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-gem"></i> Our Guiding Principles</h2>
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-eye"></i></div>
        <h3>Total Transparency</h3>
        <p>No unexpected hidden fees at checkout. Nightly rates, service fees, and cancellation terms are clearly detailed upfront.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-pen-ruler"></i></div>
        <h3>Thoughtful Design</h3>
        <p>Clean, distraction-free interfaces crafted with precision, accessibility, and speed so planning trips is an absolute joy.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-shield-halved"></i></div>
        <h3>Uncompromising Trust</h3>
        <p>Cryptographic password hashing, secure payment processing, and verified host credentials keep our travelers protected.</p>
      </div>
    </div>
  </div>

  <!-- Explore Stays CTA -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Find your next escape today</h3>
      <p class="mb-0 text-muted">Explore handpicked beachfront villas, mountain chalets, and historic castles.</p>
    </div>
    <div>
      <a href="/listings" class="btn btn-dark rounded-pill px-4">Browse All Stays</a>
    </div>
  </div>
</div>
