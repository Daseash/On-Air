<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-circle-question"></i> Help Center</span>
    <h1>How can we help you?</h1>
    <p class="mx-auto">Find answers to common questions about reservations, hosting, payments, cancellations, and account security.</p>
  </div>

  <!-- Quick Topic Cards -->
  <div class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-calendar-check"></i></div>
        <h3>Booking & Trips</h3>
        <p>Learn how reservations work, changing travel dates, check-in instructions, and guest requirements.</p>
        <a href="#booking-faqs" class="btn btn-outline-dark btn-sm rounded-pill mt-auto">View Guides</a>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-rotate-left"></i></div>
        <h3>Cancellations & Refunds</h3>
        <p>Understand our 48-hour free cancellation policy, partial refund tiers, and processing times.</p>
        <a href="/cancellation" class="btn btn-outline-dark btn-sm rounded-pill mt-auto">Refund Policy</a>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-credit-card"></i></div>
        <h3>Payments & Pricing</h3>
        <p>Transparent fee breakdowns (8% cleaning + 12% service fee), accepted payment methods, and invoices.</p>
        <a href="#payment-faqs" class="btn btn-outline-dark btn-sm rounded-pill mt-auto">Pricing Info</a>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-house-user"></i></div>
        <h3>Hosting on ON AIR</h3>
        <p>Guidance for hosts: publishing listings, managing house rules, communicating with guests, and payouts.</p>
        <a href="/host-resources" class="btn btn-outline-dark btn-sm rounded-pill mt-auto">Host Resources</a>
      </div>
    </div>
  </div>

  <!-- Frequently Asked Questions -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-comments"></i> Frequently Asked Questions</h2>
    
    <div class="accordion info-accordion" id="helpFaqAccordion">
      <!-- Q1 -->
      <div class="accordion-item" id="booking-faqs">
        <h2 class="accordion-header" id="headingOne">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
            How do I reserve a stay on ON AIR?
          </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#helpFaqAccordion">
          <div class="accordion-body">
            Browse our catalog from the home page or search directly for specific cities, beachfront villas, or cabins. On the listing's details page, pick your check-in and check-out dates, select the number of guests, and tap <strong>Reserve</strong>. If you don't have an account yet, you will be prompted to sign up or log in.
          </div>
        </div>
      </div>

      <!-- Q2 -->
      <div class="accordion-item" id="payment-faqs">
        <h2 class="accordion-header" id="headingTwo">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
            How are booking totals calculated?
          </button>
        </h2>
        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#helpFaqAccordion">
          <div class="accordion-body">
            Total pricing is computed clearly with zero hidden surprises: <code>(Nightly Rate × Number of Nights) + 8% Cleaning Fee + 12% ON AIR Service & Support Fee</code>. All taxes and platform protections are factored in before you confirm.
          </div>
        </div>
      </div>

      <!-- Q3 -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingThree">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
            What is the cancellation and refund policy?
          </button>
        </h2>
        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#helpFaqAccordion">
          <div class="accordion-body">
            Free cancellation is provided for all reservations up to <strong>48 hours</strong> before check-in. Cancellations between 48 and 24 hours receive a 50% refund. Cancellations within 24 hours of check-in are non-refundable. For full policy terms, visit our <a href="/cancellation" class="fw-bold">Cancellation Options</a> page.
          </div>
        </div>
      </div>

      <!-- Q4 -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingFour">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
            How do I check in to my listing?
          </button>
        </h2>
        <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#helpFaqAccordion">
          <div class="accordion-body">
            Once your booking is confirmed, check-in instructions and exact location details appear under <a href="/bookings/my-trips" class="fw-bold">My Trips</a>. Standard check-in begins at 2:00 PM local time. Many hosts offer keypad or smart-lock self check-in.
          </div>
        </div>
      </div>

      <!-- Q5 -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingFive">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
            Can I bring pets along?
          </button>
        </h2>
        <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#helpFaqAccordion">
          <div class="accordion-body">
            Listings marked with the <strong>Pet-friendly</strong> badge welcome cats and dogs (up to 2 pets per stay). Some hosts may charge a modest additional pet cleaning fee which is disclosed prior to checkout.
          </div>
        </div>
      </div>

      <!-- Q6 -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingSix">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSix" aria-expanded="false" aria-controls="collapseSix">
            How do I get in touch with customer support or report an issue?
          </button>
        </h2>
        <div id="collapseSix" class="accordion-collapse collapse" aria-labelledby="headingSix" data-bs-parent="#helpFaqAccordion">
          <div class="accordion-body">
            You can reach our team anytime via the <a href="/contact" class="fw-bold">Contact Page</a>, or launch our intelligent 24/7 AI travel concierge <strong>E.D.I.T.H.</strong> using the floating button at the bottom-right corner of any page.
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact CTA -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Still need assistance?</h3>
      <p class="mb-0 text-muted">Our support champions and AI travel concierge are available around the clock.</p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-dark rounded-pill px-4" type="button" onclick="document.getElementById('rag-toggle-btn') && document.getElementById('rag-toggle-btn').click();">
        <i class="fa-solid fa-sparkles me-1"></i> Ask EDITH
      </button>
      <a href="/contact" class="btn btn-outline-dark rounded-pill px-4">Contact Support</a>
    </div>
  </div>
</div>
