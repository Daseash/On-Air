<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-seedling"></i> Sustainability & Standards</span>
    <h1>Responsible Hosting</h1>
    <p class="mx-auto">Being a great host means caring for your guests, honoring your neighborhood, obeying local laws, and treading lightly on the environment.</p>
  </div>

  <!-- Key Pillars -->
  <div class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-volume-xmark"></i></div>
        <h3>Neighborhood Harmony</h3>
        <p>Establish firm quiet hours (10:00 PM – 8:00 AM), designated parking zones, and clear policies prohibiting unauthorized parties or events.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-scale-balanced"></i></div>
        <h3>Legal & Tax Compliance</h3>
        <p>Ensure your stay complies with local municipal bylaws, tourism board registrations, building societies, and applicable tax obligations (e.g. GST).</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-leaf"></i></div>
        <h3>Eco-Friendly Practices</h3>
        <p>Support sustainable tourism by providing filtered drinking water, energy-efficient LED fixtures, composting, and refillable bathroom amenities.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-kit-medical"></i></div>
        <h3>Emergency Preparedness</h3>
        <p>Equip your space with certified fire extinguishers, easily accessible first-aid kits, and laminated emergency evacuation diagrams in local languages.</p>
      </div>
    </div>
  </div>

  <!-- Best Practices Checklist -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-clipboard-check"></i> Responsible Hosting Checklist</h2>
    <div class="bg-white border rounded-3 p-4">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="d-flex align-items-start gap-2">
            <i class="fa-solid fa-circle-check text-success mt-1"></i>
            <div>
              <strong class="d-block small text-dark">Inform Your Neighbors</strong>
              <p class="small text-muted mb-0">Let neighbors know you host travelers and share a direct phone number where you can be reached if any concerns arise.</p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="d-flex align-items-start gap-2">
            <i class="fa-solid fa-circle-check text-success mt-1"></i>
            <div>
              <strong class="d-block small text-dark">Verify Safety Alarms Regularly</strong>
              <p class="small text-muted mb-0">Test smoke alarms and carbon monoxide detectors on a monthly schedule, changing batteries at least once every six months.</p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="d-flex align-items-start gap-2">
            <i class="fa-solid fa-circle-check text-success mt-1"></i>
            <div>
              <strong class="d-block small text-dark">Post Clear Waste Separation Rules</strong>
              <p class="small text-muted mb-0">Provide distinct labeled bins for dry recyclables, compostable food waste, and non-recyclable refuse.</p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="d-flex align-items-start gap-2">
            <i class="fa-solid fa-circle-check text-success mt-1"></i>
            <div>
              <strong class="d-block small text-dark">Emergency Contact Placard</strong>
              <p class="small text-muted mb-0">Keep a prominently displayed card with local emergency numbers (112, nearest hospital, local police station, and host mobile).</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Safety CTA -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Have questions about local hosting rules?</h3>
      <p class="mb-0 text-muted">Learn more on our safety overview or contact our host support specialists.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/safety" class="btn btn-outline-dark rounded-pill px-4">Safety Information</a>
      <a href="/contact" class="btn btn-dark rounded-pill px-4">Contact Support</a>
    </div>
  </div>
</div>
