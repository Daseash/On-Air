<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-newspaper"></i> Media Center</span>
    <h1>Press & Newsroom</h1>
    <p class="mx-auto">Official announcements, platform updates, media kits, and brand assets from ON AIR.</p>
  </div>

  <!-- Recent Press Releases -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-bullhorn"></i> Latest News & Announcements</h2>
    <div class="list-group">
      <div class="list-group-item p-4 border rounded-3 mb-3 bg-white">
        <span class="text-muted small d-block mb-1">October 2026 • Product Release</span>
        <h4 class="h5 fw-bold mb-2">ON AIR Unveils E.D.I.T.H.: Next-Gen AI Travel Concierge</h4>
        <p class="small text-muted mb-0">Introducing E.D.I.T.H., a grounded retrieval-augmented intelligence assistant trained exclusively on authentic listings and cancellation guidelines to guide travelers in real-time.</p>
      </div>

      <div class="list-group-item p-4 border rounded-3 mb-3 bg-white">
        <span class="text-muted small d-block mb-1">September 2026 • Expansion</span>
        <h4 class="h5 fw-bold mb-2">ON AIR Reaches 10,000 Curated Stays Across 45 Countries</h4>
        <p class="small text-muted mb-0">Rapid expansion of off-grid cabins, sustainable treehouses, and beachfront villas reflects travelers' surging preference for distinctive architectural stays over conventional hotel rooms.</p>
      </div>

      <div class="list-group-item p-4 border rounded-3 bg-white">
        <span class="text-muted small d-block mb-1">August 2026 • Research</span>
        <h4 class="h5 fw-bold mb-2">2026 Travel Study: Flexible Cancellation Drives 80% of Weekend Getaways</h4>
        <p class="small text-muted mb-0">Our comprehensive traveler study highlights transparent upfront fees and 48-hour free cancellation as the primary drivers of spontaneous domestic travel.</p>
      </div>
    </div>
  </div>

  <!-- Brand Assets -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-palette"></i> Brand Assets & Media Kit</h2>
    <div class="p-4 border rounded-3 bg-white">
      <div class="row align-items-center g-4">
        <div class="col-md-7">
          <h4 class="h6 fw-bold mb-2">Official ON AIR Logos & Guidelines</h4>
          <p class="small text-muted mb-3">Download our high-resolution SVG logomarks, typography specs, and usage guidelines for print and digital publications.</p>
          <div class="d-flex gap-2">
            <a href="/favicon.svg" download="onair-logo.svg" class="btn btn-outline-dark btn-sm rounded-pill">
              <i class="fa-solid fa-download me-1"></i> Download Vector SVG
            </a>
          </div>
        </div>
        <div class="col-md-5 text-center">
          <div class="p-4 bg-light rounded-3 d-inline-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="36" height="36" style="fill: #18181b;">
              <path d="M16 1c2.008 0 3.463.963 4.751 3.269l.533 1.025c1.954 3.83 6.114 12.54 7.1 14.836l.145.353c.667 1.591.91 2.472.96 3.396l.011.321c0 4.542-3.704 7.8-8.5 7.8-2.613 0-4.992-1.077-6.5-2.73-1.508 1.653-3.887 2.73-6.5 2.73-4.796 0-8.5-3.258-8.5-7.8 0-1.12.274-2.222.97-3.717l.147-.353c.985-2.296 5.145-11.006 7.1-14.836l.533-1.025C8.537 1.963 9.992 1 12 1h4zm0 2.2c-1.298 0-2.316.634-3.414 2.658l-.512.986c-1.936 3.792-6.082 12.472-7.045 14.717l-.147.353C4.26 23.23 4.1 24.032 4.1 24.8c0 3.308 2.692 5.6 6.3 5.6 2.215 0 4.228-1.002 5.344-2.607l.256-.393.256.393c1.116 1.605 3.129 2.607 5.344 2.607 3.608 0 6.3-2.292 6.3-5.6 0-.768-.16-1.57-.782-2.886l-.145-.353c-.963-2.245-5.109-10.925-7.045-14.717l-.512-.986C18.316 3.834 17.298 3.2 16 3.2zm0 13.8c2.426 0 4.4 1.974 4.4 4.4 0 2.247-1.688 4.098-3.87 4.368l-.23.016-.3-.016c-2.182-.27-3.87-2.121-3.87-4.368 0-2.426 1.974-4.4 4.4-4.4zm0 2.2c-1.215 0-2.2.985-2.2 2.2 0 1.134.86 2.067 1.965 2.186l.235.014.235-.014c1.105-.119 1.965-1.052 1.965-2.186 0-1.215-.985-2.2-2.2-2.2z"/>
            </svg>
            <span class="fw-bold fs-5" style="letter-spacing: -0.02em;">ON AIR</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Media Contact -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Journalist or Media Representative?</h3>
      <p class="mb-0 text-muted">For interview requests, statistics, or media commentary, contact our press relations team.</p>
    </div>
    <div>
      <a href="mailto:press@onair.com" class="btn btn-dark rounded-pill px-4">
        <i class="fa-solid fa-envelope me-1"></i> Contact press@onair.com
      </a>
    </div>
  </div>
</div>
