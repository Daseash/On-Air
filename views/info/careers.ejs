<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-briefcase"></i> Work With Us</span>
    <h1>Shape the Future of Travel & Stays</h1>
    <p class="mx-auto">We are a passionate team of engineers, designers, and travel enthusiasts building the next generation of hospitality experiences.</p>
  </div>

  <!-- Why ON AIR -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-sparkles"></i> Life at ON AIR</h2>
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-laptop-code"></i></div>
        <h3>Remote-First Flexibility</h3>
        <p>Work from wherever you produce your best work. Whether from home, a seaside cafe, or a mountain cabin.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-plane-departure"></i></div>
        <h3>Annual Travel Stipend</h3>
        <p>Every team member receives an annual ₹1,50,000 travel credit to experience stays on ON AIR across the globe.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-heart-pulse"></i></div>
        <h3>Wellness & Health</h3>
        <p>Comprehensive health insurance for you and your dependents, mental health stipends, and wellness allowances.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-graduation-cap"></i></div>
        <h3>Continuous Growth</h3>
        <p>Generous book budgets, conference allowances, and mentorship programs to support your professional evolution.</p>
      </div>
    </div>
  </div>

  <!-- Open Positions -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-user-plus"></i> Open Roles</h2>
    <div class="list-group">
      <!-- Role 1 -->
      <div class="list-group-item p-4 border rounded-3 mb-3 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
          <h4 class="h5 fw-bold mb-0">Senior Full-Stack Engineer</h4>
          <span class="badge bg-dark rounded-pill">Engineering • Remote</span>
        </div>
        <p class="small text-muted mb-3">Architect responsive web experiences, high-throughput APIs, and serverless Node.js infrastructure powering stays discovery.</p>
        <a href="mailto:careers@onair.com?subject=Application:%20Senior%20Full-Stack%20Engineer" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          <i class="fa-solid fa-paper-plane me-1"></i> Apply via Email
        </a>
      </div>

      <!-- Role 2 -->
      <div class="list-group-item p-4 border rounded-3 mb-3 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
          <h4 class="h5 fw-bold mb-0">AI & Retrieval Systems Engineer</h4>
          <span class="badge bg-dark rounded-pill">AI & Search • Remote</span>
        </div>
        <p class="small text-muted mb-3">Enhance E.D.I.T.H., our proprietary AI concierge, building vector embeddings, ranking pipelines, and natural language stay discovery.</p>
        <a href="mailto:careers@onair.com?subject=Application:%20AI%20Systems%20Engineer" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          <i class="fa-solid fa-paper-plane me-1"></i> Apply via Email
        </a>
      </div>

      <!-- Role 3 -->
      <div class="list-group-item p-4 border rounded-3 mb-3 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
          <h4 class="h5 fw-bold mb-0">Senior Product Designer</h4>
          <span class="badge bg-dark rounded-pill">Design • Remote / Hybrid</span>
        </div>
        <p class="small text-muted mb-3">Lead UI/UX craftsmanship across mobile and desktop interfaces, establishing intuitive checkout and booking flows.</p>
        <a href="mailto:careers@onair.com?subject=Application:%20Senior%20Product%20Designer" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          <i class="fa-solid fa-paper-plane me-1"></i> Apply via Email
        </a>
      </div>

      <!-- Role 4 -->
      <div class="list-group-item p-4 border rounded-3 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
          <h4 class="h5 fw-bold mb-0">Trust & Safety Operations Lead</h4>
          <span class="badge bg-dark rounded-pill">Operations • Bengaluru</span>
        </div>
        <p class="small text-muted mb-3">Ensure guest and host safety standards, investigate reported concerns, and manage escalation protocols.</p>
        <a href="mailto:careers@onair.com?subject=Application:%20Trust%20and%20Safety%20Lead" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          <i class="fa-solid fa-paper-plane me-1"></i> Apply via Email
        </a>
      </div>
    </div>
  </div>

  <!-- General Application CTA -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Don't see your specific role?</h3>
      <p class="mb-0 text-muted">Send your resume, portfolio, and what you'd love to build with us to <a href="mailto:careers@onair.com" class="fw-bold text-dark">careers@onair.com</a>.</p>
    </div>
    <div>
      <a href="mailto:careers@onair.com?subject=General%20Application%20-%20ON%20AIR" class="btn btn-dark rounded-pill px-4">Send Open Application</a>
    </div>
  </div>
</div>
