<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-users"></i> Global Community</span>
    <h1>The ON AIR Community Forum & Hub</h1>
    <p class="mx-auto">Connect with passionate hosts, seasoned travelers, and local guides sharing stories, advice, and tips for creating unforgettable experiences.</p>
  </div>

  <!-- Community Values -->
  <div class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-heart"></i></div>
        <h3>Warm Hospitality</h3>
        <p>We believe every journey becomes special through human connection, thoughtful touches, and genuine warmth.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-handshake"></i></div>
        <h3>Mutual Respect</h3>
        <p>A thriving community thrives on respect between guests, hosts, and neighboring residents in every destination.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-earth-americas"></i></div>
        <h3>Global Inclusivity</h3>
        <p>ON AIR has zero tolerance for discrimination based on race, religion, nationality, disability, or gender identity.</p>
      </div>
    </div>
  </div>

  <!-- Host Stories -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-feather-pointed"></i> Host & Traveler Spotlights</h2>
    <div class="row g-4">
      <div class="col-md-6">
        <div class="p-4 border rounded-3 bg-white h-100">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 48px; height: 48px;">AK</div>
            <div>
              <h4 class="h6 fw-bold mb-0">Aarav & Kavita</h4>
              <span class="small text-muted">Superhosts in North Goa • 3 Years on ON AIR</span>
            </div>
          </div>
          <p class="small text-muted mb-0">"Opening our Portuguese heritage villa to travelers has connected us with fascinating people from around the world. The ON AIR platform makes communication effortless and protected."</p>
        </div>
      </div>

      <div class="col-md-6">
        <div class="p-4 border rounded-3 bg-white h-100">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 48px; height: 48px;">RM</div>
            <div>
              <h4 class="h6 fw-bold mb-0">Rohan Mehta</h4>
              <span class="small text-muted">Cabin Host in Manali • 2 Years on ON AIR</span>
            </div>
          </div>
          <p class="small text-muted mb-0">"Our cedarwood mountain cabin was a passion project. Hosting travelers looking for a serene retreat amidst Himalayan peaks has been one of the most rewarding adventures of our lives."</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Discussion Topics -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-comments"></i> Active Host Circles & Discussions</h2>
    <div class="list-group">
      <div class="list-group-item list-group-item-action p-3 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-1 h6 fw-bold">Tips for Preparing Coastal Stays for Monsoon Season</h5>
          <p class="mb-1 small text-muted">Hosts sharing advice on waterproofing, humidity management, and indoor entertainment for guests.</p>
          <small class="text-muted"><i class="fa-regular fa-clock me-1"></i> Updated 2 hours ago • 48 replies</small>
        </div>
        <span class="badge bg-light text-dark border rounded-pill">Hosting Advice</span>
      </div>

      <div class="list-group-item list-group-item-action p-3 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-1 h6 fw-bold">Favorite Sustainable & Zero-Waste Amenities</h5>
          <p class="mb-1 small text-muted">Exploring refillable organic toiletries, local coffee bean partnerships, and filtered water systems.</p>
          <small class="text-muted"><i class="fa-regular fa-clock me-1"></i> Updated yesterday • 82 replies</small>
        </div>
        <span class="badge bg-light text-dark border rounded-pill">Sustainability</span>
      </div>

      <div class="list-group-item list-group-item-action p-3 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-1 h6 fw-bold">Crafting a Standout Local Digital Guidebook</h5>
          <p class="mb-1 small text-muted">What hidden gems, cafes, and scenic walks do guests appreciate most in their welcome notes?</p>
          <small class="text-muted"><i class="fa-regular fa-clock me-1"></i> Updated 3 days ago • 115 replies</small>
        </div>
        <span class="badge bg-light text-dark border rounded-pill">Hospitality</span>
      </div>
    </div>
  </div>

  <!-- Community CTA -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Join the conversation</h3>
      <p class="mb-0 text-muted">Share your host story or learn from thousands of fellow creators.</p>
    </div>
    <div>
      <a href="/listings/new" class="btn btn-dark rounded-pill px-4">Start Hosting</a>
    </div>
  </div>
</div>
