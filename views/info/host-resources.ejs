<% layout('layouts/boilerplate') %>

<div class="info-page-container">
  <div class="info-header text-center">
    <span class="info-header-badge"><i class="fa-solid fa-key"></i> Hosting Toolkit</span>
    <h1>Host Resources & Playbooks</h1>
    <p class="mx-auto">Everything you need to showcase your space, welcome travelers from around the world, and build a rewarding hosting business.</p>
  </div>

  <!-- Key Resource Guides -->
  <div class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-camera"></i></div>
        <h3>Photography & Listing Appeal</h3>
        <p>Learn how natural lighting, wide-angle shots, and thoughtful descriptions boost booking conversion by over 40%.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-chart-line"></i></div>
        <h3>Smart Pricing Strategies</h3>
        <p>Set competitive base rates, adjust for peak seasonal holidays, and bundle fair cleaning fees that attract guests.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-bell-concierge"></i></div>
        <h3>Delivering 5-Star Hospitality</h3>
        <p>From keyless self check-in guides to local dining recommendations, discover how top hosts earn stellar reviews.</p>
      </div>

      <div class="info-card">
        <div class="info-card-icon"><i class="fa-solid fa-shield-cat"></i></div>
        <h3>Host Peace of Mind</h3>
        <p>ON AIR verified guest profiles, secure deposit protections, and clear house rules protect your property around the clock.</p>
      </div>
    </div>
  </div>

  <!-- 4 Step Hosting Roadmap -->
  <div class="info-section">
    <h2 class="info-section-title"><i class="fa-solid fa-road"></i> Your Path to Successful Hosting</h2>
    <div class="bg-white border rounded-3 p-4">
      <div class="row g-4">
        <div class="col-md-3">
          <div class="p-3 bg-light rounded-3 h-100">
            <span class="badge bg-dark rounded-pill mb-2">Step 1</span>
            <h4 class="h6 fw-bold">List Your Space</h4>
            <p class="small text-muted mb-0">Describe your property, set nightly rates, and upload high-resolution photos in under 5 minutes.</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 bg-light rounded-3 h-100">
            <span class="badge bg-dark rounded-pill mb-2">Step 2</span>
            <h4 class="h6 fw-bold">Set House Rules</h4>
            <p class="small text-muted mb-0">Define quiet hours, pet policies, maximum occupancy, and check-in times (standard 2:00 PM).</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 bg-light rounded-3 h-100">
            <span class="badge bg-dark rounded-pill mb-2">Step 3</span>
            <h4 class="h6 fw-bold">Welcome Guests</h4>
            <p class="small text-muted mb-0">Provide simple access codes and greet travelers with a warm, clean, and comfortable environment.</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 bg-light rounded-3 h-100">
            <span class="badge bg-dark rounded-pill mb-2">Step 4</span>
            <h4 class="h6 fw-bold">Get Paid Reliably</h4>
            <p class="small text-muted mb-0">Payouts are initiated directly to your bank account 24 hours after successful guest check-in.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Ready to Host CTA -->
  <div class="info-cta-box">
    <div>
      <h3 class="mb-1" style="font-family: var(--font-display); font-weight: 700;">Ready to become an ON AIR Host?</h3>
      <p class="mb-0 text-muted">Join thousands of hosts welcoming travelers across beachfront villas, mountain retreats, and city lofts.</p>
    </div>
    <div>
      <a href="/listings/new" class="btn btn-dark rounded-pill px-4">
        <i class="fa-solid fa-plus me-1"></i> Add a New Stay
      </a>
    </div>
  </div>
</div>
