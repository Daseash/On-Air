<% layout('layouts/boilerplate') %>

<div class="form-page py-5">
  <div class="form-card mx-auto shadow-sm rounded-4 p-4 p-md-5" style="max-width: 460px; background: #fff; border: 1px solid #e4e4e7;">
    <h2 class="text-center fw-bold mb-1">Welcome back</h2>
    <p class="form-subtitle text-center text-muted mb-4 fs-6">
      Sign in with your username and password to manage stays and bookings.
    </p>

    <form method="POST" action="/login" novalidate class="needs-validation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>" />
      
      <div class="mb-3">
        <label for="username" class="form-label fw-semibold">Username</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-regular fa-user"></i></span>
          <input
            type="text"
            id="username"
            name="username"
            class="form-control form-control-lg fs-6 border-start-0 ps-0"
            placeholder="Enter your username"
            required
            autofocus
          />
        </div>
        <div class="invalid-feedback">Please enter your username.</div>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label for="password" class="form-label fw-semibold mb-0">Password</label>
          <a href="/reset-password" class="small text-muted text-decoration-none">Forgot password?</a>
        </div>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control form-control-lg fs-6 border-start-0 ps-0"
            placeholder="••••••••"
            required
          />
        </div>
        <div class="invalid-feedback">Please enter your password.</div>
      </div>

      <button class="btn btn-accent btn-lg btn-block w-100 py-3 mt-2 fw-semibold" type="submit">
        <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
      </button>
    </form>

    <p class="form-switch-link mt-4 text-center small text-muted">
      Don't have an account? <a href="/signup<%= typeof next !== 'undefined' && next ? '?next=' + encodeURIComponent(next) : '' %>" class="fw-semibold text-dark text-decoration-underline">Sign up</a>
    </p>
  </div>
</div>
