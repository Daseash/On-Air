<% layout('layouts/boilerplate') %>

<div class="form-page py-5">
  <div class="form-card mx-auto shadow-sm rounded-4 p-4 p-md-5" style="max-width: 480px; background: #fff; border: 1px solid #e4e4e7;">
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light mb-3" style="width: 56px; height: 56px;">
        <i class="fa-solid fa-key fs-4 text-dark"></i>
      </div>
      <h2 class="fw-bold mb-1">Change Password</h2>
      <p class="text-muted fs-6 mb-0">Update your account password stored securely in MongoDB.</p>
    </div>

    <form method="POST" action="/change-password" novalidate class="needs-validation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="mb-3">
        <label for="oldPassword" class="form-label fw-semibold">Current Password</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
          <input
            type="password"
            id="oldPassword"
            name="oldPassword"
            class="form-control form-control-lg fs-6 border-start-0 ps-0"
            placeholder="Enter current password"
            required
            autofocus
          />
        </div>
        <div class="invalid-feedback">Please enter your current password.</div>
      </div>

      <div class="mb-3">
        <label for="newPassword" class="form-label fw-semibold">New Password</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-shield-halved"></i></span>
          <input
            type="password"
            id="newPassword"
            name="newPassword"
            minlength="6"
            class="form-control form-control-lg fs-6 border-start-0 ps-0"
            placeholder="Min 6 characters"
            required
          />
        </div>
        <div class="invalid-feedback">New password must be at least 6 characters.</div>
      </div>

      <div class="mb-4">
        <label for="confirmPassword" class="form-label fw-semibold">Confirm New Password</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-check-double"></i></span>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            minlength="6"
            class="form-control form-control-lg fs-6 border-start-0 ps-0"
            placeholder="Confirm new password"
            required
          />
        </div>
        <div class="invalid-feedback">Please re-enter your new password.</div>
      </div>

      <button class="btn btn-accent btn-lg btn-block w-100 py-3 fw-semibold" type="submit">
        <i class="fa-solid fa-floppy-disk me-1"></i> Update Password
      </button>

      <div class="text-center mt-3">
        <a href="/listings" class="btn btn-link text-muted text-decoration-none small">
          <i class="fa-solid fa-arrow-left me-1"></i> Cancel & Return to Stays
        </a>
      </div>
    </form>
  </div>
</div>
