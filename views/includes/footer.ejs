<script>
  (function () {
    // Language & Currency selector interaction
    const savedLang = localStorage.getItem('onair_user_lang');
    const savedCurrency = localStorage.getItem('onair_user_currency');

    function updateLabels(lang, currency) {
      if (lang) {
        document.querySelectorAll('.footer-lang-text').forEach((el) => {
          el.textContent = lang;
        });
      }
      if (currency) {
        document.querySelectorAll('.footer-currency-text').forEach((el) => {
          el.textContent = currency;
        });
      }
    }

    if (savedLang || savedCurrency) {
      updateLabels(savedLang, savedCurrency);
    }

    document.querySelectorAll('.lang-currency-item[data-lang]').forEach((item) => {
      if (savedLang && item.getAttribute('data-lang') === savedLang) {
        document.querySelectorAll('.lang-currency-item[data-lang]').forEach((i) => i.classList.remove('active'));
        item.classList.add('active');
      }
      item.addEventListener('click', function () {
        const val = this.getAttribute('data-lang');
        localStorage.setItem('onair_user_lang', val);
        document.querySelectorAll('.lang-currency-item[data-lang]').forEach((i) => i.classList.remove('active'));
        this.classList.add('active');
        updateLabels(val, null);
        const modalEl = document.getElementById('langCurrencyModal');
        if (modalEl && window.bootstrap) {
          const m = bootstrap.Modal.getInstance(modalEl);
          if (m) m.hide();
        }
      });
    });

    document.querySelectorAll('.lang-currency-item[data-currency]').forEach((item) => {
      if (savedCurrency && item.getAttribute('data-currency') === savedCurrency) {
        document.querySelectorAll('.lang-currency-item[data-currency]').forEach((i) => i.classList.remove('active'));
        item.classList.add('active');
      }
      item.addEventListener('click', function () {
        const val = this.getAttribute('data-currency');
        localStorage.setItem('onair_user_currency', val);
        document.querySelectorAll('.lang-currency-item[data-currency]').forEach((i) => i.classList.remove('active'));
        this.classList.add('active');
        updateLabels(null, val);
        const modalEl = document.getElementById('langCurrencyModal');
        if (modalEl && window.bootstrap) {
          const m = bootstrap.Modal.getInstance(modalEl);
          if (m) m.hide();
        }
      });
    });
  })();
</script>
