<section class="promo-band">
  <div class="container-xl promo-band-inner">
    <div class="promo-copy">
      <span class="promo-eyebrow">Become a host</span>
      <h2 class="promo-title">It&rsquo;s easy to start hosting and earn extra income</h2>
      <p class="promo-text">
        List your place on ON AIR — set your own price, share your space, and welcome guests from around the world.
      </p>
      <a href="/listings/new" class="btn btn-accent btn-lg btn-magnetic" data-magnetic>
        <i class="fa-solid fa-house-circle-check me-1"></i> Start hosting
      </a>
    </div>
    <div class="promo-art" aria-hidden="true">
      <div class="promo-art-card promo-art-card--1"><i class="fa-solid fa-key"></i></div>
      <div class="promo-art-card promo-art-card--2"><i class="fa-solid fa-hand-holding-dollar"></i></div>
      <div class="promo-art-card promo-art-card--3"><i class="fa-solid fa-map-location-dot"></i></div>
    </div>
  </div>
</section>

<section class="container-xl trust-band">
  <div class="trust-header">
    <span class="promo-eyebrow">ON AIR Cover</span>
    <h2 class="section-title">Every booking includes free protection</h2>
    <p>Your trip is protected from Host cancellations, listing inaccuracies, and more.</p>
  </div>
  <div class="trust-grid">
    <div class="trust-item">
      <i class="fa-solid fa-shield-halved"></i>
      <h4>Booking Protection Guarantee</h4>
      <p>If a Host cancels on you, find a similar or better home, or we&rsquo;ll refund you.</p>
    </div>
    <div class="trust-item">
      <i class="fa-solid fa-check-double"></i>
      <h4>Get-What-You-Booked Guarantee</h4>
      <p>If your stay isn&rsquo;t what you booked, we&rsquo;ll find a similar home or refund you.</p>
    </div>
    <div class="trust-item">
      <i class="fa-solid fa-headset"></i>
      <h4>24-hour Safety Line</h4>
      <p>Priority access to specially-trained safety agents, any time, day or night.</p>
    </div>
