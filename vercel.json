{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "views/**",
        "init/**",
        "public/**",
        "rag/data/**"
      ],
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
